cabal-version:      2.4
name:               fp-lab1
version:            1.0.0
synopsis:           Інформаційна система "Розклад роботи дисплейних класів факультету"
build-type:         Simple

executable display-classes
    main-is:          Main.hs
    hs-source-dirs:   app, src
    other-modules:    Model, Storage, Display, Form, Prompt, Reports, Connection
    build-depends:    base >=4.14 && <5,
                      mysql-simple >=0.4.9,
                      mysql >=0.2,
                      time
    default-language: Haskell2010
    ghc-options:      -Wall
